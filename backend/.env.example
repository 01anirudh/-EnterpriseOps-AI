# ─────────────────────────────────────────────
# EnterpriseOps AI — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM ──────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Alternative: OPENAI_API_KEY=sk-...

# ── Database ─────────────────────────────────
POSTGRES_USER=enterpriseops
POSTGRES_PASSWORD=enterpriseops_secret
POSTGRES_DB=enterpriseops
DATABASE_URL=postgresql+asyncpg://enterpriseops:enterpriseops_secret@localhost:5432/enterpriseops
DATABASE_SYNC_URL=postgresql://enterpriseops:enterpriseops_secret@localhost:5432/enterpriseops

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Qdrant ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_docs

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Gmail Integration ─────────────────────────
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json
# Leave blank to use mock mode
GMAIL_SENDER_EMAIL=

# ── Slack Integration ─────────────────────────
# Leave blank to use mock mode
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#general

# ── GitHub Integration ────────────────────────
# Leave blank to use mock mode
GITHUB_TOKEN=
GITHUB_REPO=owner/repository-name

# ── App Settings ──────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=documents/uploads
REPORTS_DIR=documents/reports

# ── Embedding Model ───────────────────────────
# Uses local SentenceTransformer (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
